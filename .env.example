# ==============================================================================
# Doopack - Production Environment Variables
# ==============================================================================

# HTTP Port to expose on the VPS host (e.g. 80, 8080, 4500)
APP_PORT=80

# Redis authentication password
REDIS_PASSWORD=doopack_secure_redis_password_change_me

# Backend internal connection strings (configured for docker compose network)
DATABASE_URL=sqlite:///app/data/orchestrator.db
REDIS_URL=redis://:doopack_secure_redis_password_change_me@redis:6379

# Logging Level (error, warn, info, debug, trace)
RUST_LOG=info
